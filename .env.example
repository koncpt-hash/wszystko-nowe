# Skopiuj do pliku .env.local (lokalnie) albo wpisz w Vercel → Settings → Environment Variables.
# Oba klucze są w Supabase: Project Settings → API (lub API Keys).

# Adres projektu, np. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Klucz publiczny (anon / publishable). Może trafić do przeglądarki.
VITE_SUPABASE_ANON_KEY=

# Tylko w Vercel (nie w kodzie, nie w czacie): klucz service_role / secret, dla automatu podtrzymującego bazę.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dowolny długi losowy ciąg; Vercel wysyła go do automatu, żeby nikt inny go nie wywoływał.
CRON_SECRET=
